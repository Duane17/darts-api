// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// Enums
//
enum UserRole {
  ADMIN
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
}

enum FixtureStatus {
  SCHEDULED
  PLAYED
  POSTPONED
  CANCELED
}

enum FixtureType {
  SMK_TRADING_CRDL
  FRIENDLY
  TOURNAMENT
  TRAINING
  COMMUNITY
  WORKSHOP
}

//
// Core domain
//
model Team {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  city      String?
  active    Boolean   @default(true)

  // Optional home venue metadata
  homeVenue String?
  homeCity  String?

  // Relations
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")
  standings    Standing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([slug])
}

model Fixture {
  id          String        @id @default(uuid())
  season      String
  week        Int
  title       String
  date        DateTime
  endDate     DateTime?
  type        FixtureType   @default(SMK_TRADING_CRDL)
  venue       String
  city        String?
  description String?
  venueTBA    Boolean       @default(false)
  kickoffTBA  Boolean       @default(false)
  status      FixtureStatus @default(SCHEDULED)
  isBye       Boolean       @default(false)

  // Relations
  homeTeamId  String
  awayTeamId  String?
  homeTeam    Team          @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  awayTeam    Team?         @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull,   onUpdate: Cascade)

  // One result per fixture
  result      Result?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prevent duplicates for the same pairing on the same date within a season
  @@unique([season, date, homeTeamId, awayTeamId])
  @@index([season])
  @@index([date])
  @@index([status])
  @@index([type])
  @@index([week])
}

model Result {
  id         String   @id @default(uuid())
  fixtureId  String   @unique
  homeScore  Int
  awayScore  Int
  notes      String?

  fixture    Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Standing {
  id            String  @id @default(uuid())
  season        String
  teamId        String
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  played        Int     @default(0)
  won           Int     @default(0)
  drawn         Int     @default(0)
  lost          Int     @default(0)
  goalsFor      Int     @default(0)
  goalsAgainst  Int     @default(0)
  goalDiff      Int     @default(0)
  points        Int     @default(0)
  last5         String?

  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([season, teamId])
  @@index([season])
  @@index([points])
}

//
// Content
//
model Post {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  coverImage  String?
  excerpt     String?
  body        String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([slug])
}

model Announcement {
  id          String               @id @default(uuid())
  title       String
  body        String
  priority    AnnouncementPriority @default(NORMAL)
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([priority])
  @@index([publishedAt])
  @@index([expiresAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EDITOR)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}


model Leader {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  title       String
  photo       String?
  tagline     String?
  profile     String?
  email       String?
  phone       String?
  location    String?
  bio         String?

  // Arrays
  responsibilities      String[]
  achievements         String[]
  education            String[]
  leadershipSkills     String[]

  // Free text
  professionalBackground String?
  sportingJourney        String?
  term                   String?

  // JSON array of { platform, url }
  socials     Json?

  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([name])
  @@index([title])
}
