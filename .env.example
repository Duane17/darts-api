# Copy to .env for local dev. In production these are set in cPanel > Setup Node.js App.

# Port to listen on. Passenger sets this automatically on cPanel. Default: 4000
PORT=4000
# REQUIRED. PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
# REQUIRED. Long random string used to sign auth tokens. Falls back to "" (insecure) if unset.
JWT_SECRET=
# Token lifetime. Default: 7d
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins. Unset = allow all ("*").
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# "production" enables secure cookies and JSON logs.
NODE_ENV=development
